# AI Consensus Engine - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.

# Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: required if your Anthropic API key is organization-level and not workspace-scoped
# ANTHROPIC_WORKSPACE_ID=wrkspc_your_workspace_id_here

# Arbiter Model Provider ('claude', 'gemini', or 'openai'); 'claude' falls back to 'openai'
ARBITER_MODEL_PROVIDER=claude

# Per-worker request timeout in seconds (default: 12)
REQUEST_TIMEOUT_SECONDS=12
